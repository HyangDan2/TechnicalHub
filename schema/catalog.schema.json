{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyangdan2/TechnicalHub/catalog.schema.json",
  "title": "TechnicalHub project link catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "repositoryUrl", "categories", "inspectedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "repositoryUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["HW", "SW", "AI", "Data", "ML", "DL", "Utility", "Etc"] } },
          "inspectedAt": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
