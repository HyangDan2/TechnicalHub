<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ summary | escape }}">
    <meta name="theme-color" id="theme-color" content="#FAFAFD">
    <title>{{ title | escape }} — TechnicalHub</title>
    <link rel="canonical" href="https://hyangdan2.github.io/TechnicalHub/technologies/{{ slug | escape }}/">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="HD2Lab TechnicalHub">
    <meta property="og:title" content="{{ title | escape }} — TechnicalHub">
    <meta property="og:description" content="{{ summary | escape }}">
    <meta property="og:url" content="https://hyangdan2.github.io/TechnicalHub/technologies/{{ slug | escape }}/">
    <meta property="og:image" content="https://hyangdan2.github.io/TechnicalHub/{{ socialPreview | escape }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ socialPreviewAlt | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title | escape }} — TechnicalHub">
    <meta name="twitter:description" content="{{ summary | escape }}">
    <meta name="twitter:image" content="https://hyangdan2.github.io/TechnicalHub/{{ socialPreview | escape }}">
    <link rel="icon" href="../../assets/branding/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="../../assets/branding/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="../../assets/branding/apple-touch-icon.png" sizes="180x180">
    <link rel="shortcut icon" href="../../assets/branding/favicon.ico">
    <link rel="stylesheet" href="../../css/profile.css?v=20261118-hub-nav">
    <script>(function(){try{if(localStorage.getItem('hd2-theme')==='dark'){document.documentElement.dataset.theme='dark';var m=document.getElementById('theme-color');if(m)m.setAttribute('content','#0B1020');}}catch(e){}})();</script>
  </head>
  <body class="profile-site">
    <a class="skip-link" href="#profile-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="../../" aria-label="TechnicalHub home"><span class="mark" aria-hidden="true"></span><span class="brand-name">HD2Lab</span><em>TechnicalHub</em></a>
        <nav class="header-nav" aria-label="Hub categories">
          <a class="nav-tab" href="https://hyangdan2.github.io/">Home</a>
          <a class="nav-tab" href="https://hyangdan2.github.io/ApplicationHub/">Apps</a>
          <a class="nav-tab" href="https://hyangdan2.github.io/GameHub/">Play</a>
          <a class="nav-tab is-active" href="https://hyangdan2.github.io/TechnicalHub/" aria-current="page">Tech</a>
          <a class="nav-tab" href="https://hyangdan2.github.io/diary/">Diary</a>
          <a class="nav-tab" href="https://hyangdan2.github.io/about/">About</a>
        </nav>
        <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5.5H17M3 10H17M3 14.5H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
    </header>
    <div class="drawer-backdrop" hidden></div>
    <aside id="mobile-drawer" class="mobile-drawer" aria-label="Hub navigation" aria-hidden="true">
      <div class="drawer-head">
        <span class="drawer-title"><span class="mark mark-sm" aria-hidden="true"></span><span>Navigation</span></span>
        <button class="drawer-close" type="button" aria-label="Close menu">&times;</button>
      </div>
      <nav class="drawer-list" aria-label="Hub categories">
        <a class="drawer-item" href="https://hyangdan2.github.io/"><span class="drawer-item-meta">00 / HQ</span><span class="drawer-item-row"><strong>Web-HQ</strong><span aria-hidden="true">↗</span></span><span class="drawer-item-desc">The front door of HD2Lab</span></a>
        <a class="drawer-item" href="https://hyangdan2.github.io/ApplicationHub/"><span class="drawer-item-meta">01 / APPS</span><span class="drawer-item-row"><strong>ApplicationHub</strong><span aria-hidden="true">↗</span></span><span class="drawer-item-desc">Web applications &amp; tools</span></a>
        <a class="drawer-item" href="https://hyangdan2.github.io/GameHub/"><span class="drawer-item-meta">02 / PLAY</span><span class="drawer-item-row"><strong>GameHub</strong><span aria-hidden="true">↗</span></span><span class="drawer-item-desc">Games &amp; interaction</span></a>
        <a class="drawer-item is-current" href="https://hyangdan2.github.io/TechnicalHub/" aria-current="page"><span class="drawer-item-meta">03 / EXPLORE</span><span class="drawer-item-row"><strong>TechnicalHub</strong><span aria-hidden="true">↗</span></span><span class="drawer-item-desc">Technology, projects &amp; ideas</span></a>
        <a class="drawer-item" href="https://hyangdan2.github.io/diary/"><span class="drawer-item-meta">04 / DIARY</span><span class="drawer-item-row"><strong>HD2&rsquo;s Diary</strong><span aria-hidden="true">↗</span></span><span class="drawer-item-desc">Build notes &amp; architecture</span></a>
        <a class="drawer-item" href="https://hyangdan2.github.io/about/"><span class="drawer-item-meta">05 / ABOUT</span><span class="drawer-item-row"><strong>About HD2Lab</strong><span aria-hidden="true">↗</span></span><span class="drawer-item-desc">Who builds this and why</span></a>
      </nav>
    </aside>
    <main id="profile-content" class="profile-page shell">
      <a class="profile-back" href="../../#projects">← Back to TechnicalHub</a>
      <article>
        <header class="profile-heading">
          <p class="eyebrow"><span class="status-dot"></span> PUBLIC PROJECT PROFILE · PRIVATE SOURCE</p>
          <h1>{{ title | escape }}<span class="accent">.</span></h1>
          <p class="profile-summary">{{ summary | escape }}</p>
          <div class="profile-meta">
            {% for category in categories %}<span class="category-tag">{{ category | escape }}</span>{% endfor %}
            <span class="profile-updated">Profile updated {{ updatedAt }}</span>
          </div>
        </header>
        <section class="profile-technologies" aria-labelledby="stack-title">
          <p class="eyebrow muted">TECHNOLOGY STACK</p>
          <h2 id="stack-title">Technology Stack</h2>
          <dl>
            {% for technology in technologies %}
            <div class="technology-row">
              <dt>{{ technology.name | escape }}</dt>
              <dd>{{ technology.role | escape }}{% if technology.version %} <span class="technology-version">{{ technology.version | escape }}</span>{% endif %}</dd>
            </div>
            {% endfor %}
          </dl>
        </section>
        <div class="profile-article">{{ content | safe }}</div>
      </article>
    </main>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to dark mode" title="Switch to dark mode"><svg class="theme-toggle-ic" data-icon="moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.4 14.4A8.6 8.6 0 0 1 9.6 3.6a8.6 8.6 0 1 0 10.8 10.8z"/></svg><svg class="theme-toggle-ic" data-icon="sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.1"/><path d="M12 2.7v2.3M12 19v2.3M2.7 12h2.3M19 12h2.3M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"/></svg></button>
    <footer class="site-footer shell"><div><span class="footer-brand">HD2Lab <span class="accent">/</span> TechnicalHub</span><p>Technology profiles and architecture notes.</p></div><a href="../../#projects">Browse the hub <span aria-hidden="true">↗</span></a></footer>
    <script src="../../js/theme.js"></script>
    <script src="../../js/nav.js" defer></script>
  </body>
</html>
