<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ summary | escape }}">
    <meta name="theme-color" content="#f5f5ee">
    <title>{{ title | escape }} — TechnicalHub</title>
    <link rel="stylesheet" href="../../css/profile.css">
  </head>
  <body class="profile-site">
    <a class="skip-link" href="#profile-content">Skip to content</a>
    <header class="site-header shell">
      <a class="brand" href="../../" aria-label="TechnicalHub home"><span class="brand-icon" aria-hidden="true"></span><span>TechnicalHub<small>TECHNOLOGY ARCHIVE</small></span></a>
      <nav aria-label="Main menu"><a href="../../#projects">Explore projects</a><a href="https://hyangdan2.github.io/">Web-HQ <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="profile-content" class="profile-page shell">
      <a class="profile-back" href="../../#projects">← Back to TechnicalHub</a>
      <article>
        <header class="profile-heading">
          <p class="eyebrow"><span class="status-dot"></span> PUBLIC PROJECT PROFILE · PRIVATE SOURCE</p>
          <h1>{{ title | escape }}<span class="lime">.</span></h1>
          <p class="profile-summary">{{ summary | escape }}</p>
          <div class="profile-meta">
            {% for category in categories %}<span class="category-tag">{{ category | escape }}</span>{% endfor %}
            <span class="profile-updated">Profile updated {{ updatedAt }}</span>
          </div>
        </header>
        <section class="profile-technologies" aria-labelledby="stack-title">
          <p class="eyebrow muted">TECHNOLOGY STACK</p>
          <h2 id="stack-title">Technology Stack</h2>
          <dl>
            {% for technology in technologies %}
            <div class="technology-row">
              <dt>{{ technology.name | escape }}</dt>
              <dd>{{ technology.role | escape }}{% if technology.version %} <span class="technology-version">{{ technology.version | escape }}</span>{% endif %}</dd>
            </div>
            {% endfor %}
          </dl>
        </section>
        <div class="profile-article">{{ content | safe }}</div>
      </article>
    </main>
    <footer class="site-footer shell"><div><span class="footer-brand">TechnicalHub</span><p>Technology profiles and architecture notes.</p></div><a href="../../#projects">Browse the hub <span aria-hidden="true">↗</span></a></footer>
  </body>
</html>
